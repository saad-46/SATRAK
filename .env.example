# =============================================================================
# SATRAK — Root environment (used by docker-compose for local development)
# =============================================================================
# Copy to `.env` (gitignored) and adjust as needed:  cp .env.example .env
#
# Per-app configuration lives in apps/web/.env.example and apps/api/.env.example.
# This root file only holds values shared by the docker-compose stack.
# -----------------------------------------------------------------------------

# --- Environment ---
SATRAK_ENV=development

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=satrak
POSTGRES_PASSWORD=satrak_dev_password
POSTGRES_DB=satrak
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Host port mappings (change if these collide with local services) ---
API_PORT=8000
WEB_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
