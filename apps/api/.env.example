# =============================================================================
# SATRAK API — environment configuration
# =============================================================================
# Copy to `.env` (gitignored):  cp .env.example .env
# All variables are prefixed SATRAK_API_ and validated by app/core/config.py.
# -----------------------------------------------------------------------------

# --- Application ---
SATRAK_API_APP_NAME="SATRAK API"
SATRAK_API_ENVIRONMENT=development
SATRAK_API_DEBUG=true
SATRAK_API_VERSION=0.1.0

# --- HTTP / API ---
SATRAK_API_HOST=0.0.0.0
SATRAK_API_PORT=8000
SATRAK_API_API_V1_PREFIX=/api/v1
# Comma-separated or JSON list.
SATRAK_API_CORS_ORIGINS=http://localhost:3000

# --- Datastores ---
# Async SQLAlchemy driver (asyncpg). Leave unset to run without a DB (liveness
# stays green; readiness reports the datastore as unavailable).
SATRAK_API_DATABASE_URL=postgresql+asyncpg://satrak:satrak_dev_password@localhost:5432/satrak
SATRAK_API_DATABASE_POOL_SIZE=5
SATRAK_API_DATABASE_MAX_OVERFLOW=10
SATRAK_API_REDIS_URL=redis://localhost:6379/0

# --- Authentication (OIDC access-token validation; ADR-0013) ---
# Authentication is ON by default and the app refuses to start without an issuer and
# audience. No provider is built in: supply your own. Both URLs must be https.
# SATRAK_API_AUTH_ISSUER=
# SATRAK_API_AUTH_AUDIENCES=            # comma-separated or JSON list
# SATRAK_API_AUTH_JWKS_URL=             # optional; discovered from the issuer otherwise
# SATRAK_API_AUTH_ALLOWED_ALGORITHMS=RS256
# Local development ONLY (rejected in staging/production):
SATRAK_API_AUTH_ENABLED=false

# --- Logging ---
SATRAK_API_LOG_LEVEL=INFO
# json (production) | console (local, human-readable)
SATRAK_API_LOG_FORMAT=console
