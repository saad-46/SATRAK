# =============================================================================
# SATRAK API — environment configuration
# =============================================================================
# Copy to `.env` (gitignored):  cp .env.example .env
# All variables are prefixed SATRAK_API_ and validated by app/core/config.py.
# -----------------------------------------------------------------------------

# --- Application ---
SATRAK_API_APP_NAME="SATRAK API"
SATRAK_API_ENVIRONMENT=development
SATRAK_API_DEBUG=true
SATRAK_API_VERSION=0.1.0

# --- HTTP / API ---
SATRAK_API_HOST=0.0.0.0
SATRAK_API_PORT=8000
SATRAK_API_API_V1_PREFIX=/api/v1
# Comma-separated or JSON list.
SATRAK_API_CORS_ORIGINS=http://localhost:3000

# --- Datastores ---
# Async SQLAlchemy driver (asyncpg). Leave unset to run without a DB (liveness
# stays green; readiness reports the datastore as unavailable).
SATRAK_API_DATABASE_URL=postgresql+asyncpg://satrak:satrak_dev_password@localhost:5432/satrak
SATRAK_API_DATABASE_POOL_SIZE=5
SATRAK_API_DATABASE_MAX_OVERFLOW=10
SATRAK_API_REDIS_URL=redis://localhost:6379/0

# --- Authentication (OIDC access-token validation; ADR-0013) ---
# Authentication is ON by default and the app refuses to start without an issuer and
# audience. No provider is built in: supply your own. Both URLs must be https.
# SATRAK_API_AUTH_ISSUER=
# SATRAK_API_AUTH_AUDIENCES=            # comma-separated or JSON list
# SATRAK_API_AUTH_JWKS_URL=             # optional; discovered from the issuer otherwise
# SATRAK_API_AUTH_ALLOWED_ALGORITHMS=RS256
# Local development ONLY (rejected in staging/production):
SATRAK_API_AUTH_ENABLED=false

# --- Rate limiting and request hardening (Story 6) ---
# Required (with Redis) in staging/production; process-local in development without SATRAK_API_REDIS_URL.
# Starting values are owner-approved and meant to be tuned from measured traffic. Override a
# named policy with JSON, e.g.:
#   SATRAK_API_RATE_LIMIT_OVERRIDES={"eo_search_user":[{"limit":60,"window_seconds":60}]}
# Policies: auth_entry_ip, auth_failure_ip, api_user, eo_search_user, expensive_user, admin_user,
# api_ip and tiles_user (tiles: 120/min/user, owner-approved; the api_ip ceiling is a placeholder
# pending load and abuse testing).
SATRAK_API_RATE_LIMIT_ENABLED=true
# Number of trusted reverse proxies in front of the API; 0 ignores X-Forwarded-For entirely.
SATRAK_API_RATE_LIMIT_TRUSTED_PROXY_HOPS=0
# Networks the proxies connect from; X-Forwarded-For is trusted only from these peers.
# Required when hops > 0 in staging/production. Example: 10.0.0.0/8,fd00::/8
SATRAK_API_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
SATRAK_API_RATE_LIMIT_PENALTY_BASE_SECONDS=60
SATRAK_API_RATE_LIMIT_PENALTY_MAX_SECONDS=3600
# Per-process budget (requests/minute per key) used only while Redis is unreachable.
SATRAK_API_RATE_LIMIT_FALLBACK_PER_MINUTE=60
SATRAK_API_MAX_REQUEST_BODY_BYTES=1048576

# --- Logging ---
SATRAK_API_LOG_LEVEL=INFO
# json (production) | console (local, human-readable)
SATRAK_API_LOG_FORMAT=console

# Database role check at startup: "enforce" refuses superuser/BYPASSRLS/owner roles (default);
# "warn" only logs and is rejected in staging/production.
SATRAK_API_DATABASE_ROLE_CHECK=enforce
