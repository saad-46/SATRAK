# =============================================================================
# SATRAK Web — environment configuration
# =============================================================================
# Copy to `.env.local` (gitignored):  cp .env.example .env.local
# Validated at build/runtime by src/env.ts (fails fast on misconfiguration).
#
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.
# -----------------------------------------------------------------------------

# Base URL of the SATRAK API (browser-visible).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Human-readable environment label shown in the UI footer/status.
NEXT_PUBLIC_APP_ENV=development
